<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 本 App 作为 USB Accessory（设备端），不需要 usb.host 硬件特性 -->
    <uses-feature
        android:name="android.hardware.usb.accessory"
        android:required="true" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.UsbDisplay"
        android:hardwareAccelerated="true">

        <activity
            android:name=".UsbDisplayActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.UsbDisplay">

            <!-- 插上 Mac 且 Mac 完成 AOA 握手后自动拉起本 Activity -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
